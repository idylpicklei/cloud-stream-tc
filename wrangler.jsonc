{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-stream-tc",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Student talk-back relay. SQLite-backed Durable Objects are available on the free plan;
  // `wrangler deploy` applies the migration automatically.
  "durable_objects": {
    "bindings": [{ "name": "CLASSROOM", "class_name": "ClassRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassRoom"] }],
  // Non-secret defaults. Put secrets in `.dev.vars` locally and via `wrangler secret` in prod.
  "vars": {
    "STREAM_CUSTOMER_CODE": "",
    "STREAM_LIVE_INPUT_UID": ""
  }
}
